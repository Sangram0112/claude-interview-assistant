# Copy to .env for local development only. .env is git-ignored and never bundled.
# The recommended way to store keys is Settings > Claude API inside the app
# (saved in Windows Credential Manager).

# Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: only needed if you select Deepgram as the transcription provider
DEEPGRAM_API_KEY=your-deepgram-key-here

# Optional overrides
# CIA_CLAUDE_MODEL=claude-opus-5-5
# CIA_TRANSCRIPTION_PROVIDER=local_whisper   # or: deepgram
# CIA_WHISPER_MODEL=base.en
# CIA_DATA_DIR=C:\path\to\portable\data
# CIA_DEBUG=1
